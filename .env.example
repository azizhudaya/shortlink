# Copy to .env on the VPS only, mode 0600, owned by the deploy user.
# Never commit .env — this repo is public.
#
# One file for both services in docker-compose.yml. The web container needs
# nothing from here; every value below is consumed by shortlink-api or by
# Compose itself.

# Password for the shortlink_api Postgres role, set manually after the
# afh-infra Postgres volume was first initialized (see afh-infra's
# postgres/initdb/001_create_shortlink_db.sql).
SHORTLINK_DB_PASSWORD=changeme

# Image tag for both images. CI sets it to the commit SHA; `local` means
# "whatever this checkout builds".
GIT_SHA=local

# ---- M2: Google sign-in and Safe Browsing (consumed by shortlink-api) ----
# OAuth client "shortlink-web" from Google Cloud Console → Google Auth Platform
# → Clients. Redirect URI: https://app.afh.my.id/api/auth/google/callback
GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme
# API key restricted to the Safe Browsing API and to this VPS's IP.
SAFE_BROWSING_API_KEY=changeme

# Sign-up kill switch. Leave unset (open). During an abuse wave set it to
# `false` and run `docker compose up -d shortlink-api`: new accounts are
# refused, existing ones still sign in. Only the literal `false` closes.
# SIGNUPS_OPEN=false

# Optional: a plain-text POST here for every automatic takedown by the hourly
# Safe Browsing re-scan, e.g. https://ntfy.sh/<a-long-random-topic>. Unset =
# logs only (`docker logs shortlink-api 2>&1 | grep rescan_takedown`).
# ALERT_WEBHOOK_URL=
